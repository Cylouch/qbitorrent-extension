{
  "manifest_version": 3,
  "name": "qBittorrent Connect",
  "version": "1.1.0",
  "minimum_chrome_version": "123",
  "description": "Envoie tes .torrent et liens magnet vers ton serveur qBittorrent, avec la fenêtre d'ajout complète. Extension non officielle.",
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "notifications",
    "declarativeNetRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "qBittorrent Connect",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/magnet.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
